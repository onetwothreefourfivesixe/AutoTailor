% OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
% SOFTWARE.
%
% Template syntax (values, statements, comments, the url filter): see autotailor/resume/latex.py.
% Values: name, contact_items (text, url), sections (key, title, items: left1, right1, left2,
% right2, bullets, title, organization, location, dates, stack, stack_on), skills (name, items).

\documentclass[letterpaper,10pt]{article}

\usepackage[empty]{fullpage}
\usepackage[top=0.4in,bottom=0.4in,left=0.5in,right=0.5in]{geometry}
\usepackage{latexsym}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{tabularx}
\usepackage[usenames,dvipsnames]{color}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\ifdefined\pdfgentounicode\input{glyphtounicode}\fi

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Section formatting: small caps heading with a rule underneath
\titleformat{\section}{
  \vspace{-6pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-6pt}]

% Machine-readable text layer for resume parsers (ATS)
\ifdefined\pdfgentounicode\pdfgentounicode=1\fi

%-------------------------------------------------------------------------------
% Custom commands
%-------------------------------------------------------------------------------
\newcommand{\resumeItem}[1]{
  \item\small{#1 \vspace{-3pt}}
}

% Role entry: {Organization}{Location}{Title}{Dates}
\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.98\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & \textbf{\small #2} \\
      \textit{\small #3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-6pt}
}

% Single-line entry: {Title}{Right-hand note}
\newcommand{\resumeProjectHeading}[2]{
  \item
    \begin{tabular*}{0.98\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & \small #2 \\
    \end{tabular*}\vspace{-6pt}
}

% Tech stack after a title: \stack{Python, PyTorch}
\newcommand{\stack}[1]{\textnormal{\small\ $|$ #1}}

% One skills row: {Label}{items}
\newcommand{\skillRow}[2]{\item \textbf{#1:} #2}

\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=0.28in, itemsep=1pt, parsep=0pt, topsep=2pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-6pt}}

((# Section headings: shorter names than the layout's defaults #))
((* set headings = {"experience": "Experience", "activities": "Leadership", "volunteer": "Volunteering"} *))

%-------------------------------------------------------------------------------
\begin{document}

%----------- HEADING -----------
\begin{center}
    {\Huge \scshape ((( name )))} \\ \vspace{4pt}
    \small
    ((* for c in contact_items *))((* if c.url *))\href{((( c.url|url )))}{((( c.text )))}((* else *))((( c.text )))((* endif *))((* if not loop.last *)) $|$ ((* endif *))((* endfor *))

\end{center}
\vspace{-6pt}

((* for section in sections *))
%----------- ((( section.title|upper ))) -----------
\section{((( headings.get(section.key, section.title) )))}
((* if section.key == "activities" *))
\begin{itemize}[leftmargin=0.15in, label={}, itemsep=2pt, parsep=0pt, topsep=3pt]
  \small
((* for item in section["items"] *))
  \item \textbf{((( item.title )))}((* if item.organization *)), ((( item.organization )))((* endif *))((* if item.stack *)) \stack{((( item.stack )))}((* endif *)) \hfill ((( item.dates )))((* if item.bullets *)) \\
        ((( item.bullets|join("; ") )))((* endif *))
((* endfor *))
\end{itemize}
\vspace{-4pt}
((* else *))
\resumeSubHeadingListStart
((* for item in section["items"] *))
((* if item.left2 or item.right2 *))
  \resumeSubheading
    {((( item.left1 )))}{((( item.right1 )))}
    {((( item.left2 )))((* if item.stack and item.stack_on == "left2" *)) \stack{((( item.stack )))}((* endif *))}{((( item.right2 )))}
((* else *))
  \resumeProjectHeading{\textbf{((( item.left1 )))}((* if item.stack and item.stack_on == "left1" *)) \stack{((( item.stack )))}((* endif *))}{((( item.right1 )))}
((* endif *))
((* if item.bullets *))
  \resumeItemListStart
((* for b in item.bullets *))
((* set label, colon, rest = b.partition(": ") *))
((* if section.key == "education" and colon and label|length < 30 *))
    \resumeItem{\textbf{((( label ))):} ((( rest )))}
((* else *))
    \resumeItem{((( b )))}
((* endif *))
((* endfor *))
  \resumeItemListEnd
((* endif *))
((* endfor *))
\resumeSubHeadingListEnd
((* endif *))

((* endfor *))
((* if skills *))
%----------- SKILLS -----------
\section{Skills}
\begin{itemize}[leftmargin=0.15in, label={}, itemsep=0pt, parsep=0pt, topsep=3pt]
  \small
((* for g in skills *))
  \skillRow{((( g.name )))}{((( g["items"] )))}
((* endfor *))
\end{itemize}
((* endif *))

\end{document}
